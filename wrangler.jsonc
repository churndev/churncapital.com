{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Assets-only Worker for the homepage. Do not add a script, cron, or R2 binding here.
  // The drop-in encoder is workers/dropin/ and is disabled — requires Workers Paid.
  // Do not add routes or custom domains here. Attach domains in the dashboard.
  "name": "churncapital-com",
  "compatibility_date": "2026-11-14",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "directory": "./public"
  }
}
