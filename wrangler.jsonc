{
  // Assets-only Worker. Do not add routes or custom domains here.
  // Attach domains in the Cloudflare dashboard. There is no Worker script.
  "name": "churncapital-com",
  "compatibility_date": "2026-11-14",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "directory": "./public"
  }
}
